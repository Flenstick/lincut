# Maintainer: MrFlen <132173452+Flenstick@users.noreply.github.com>
# LinCut для Arch Linux. Установка одной командой — см. README («Arch Linux»).
pkgname=lincut
pkgver=1.4.0
pkgrel=1
pkgdesc='Видеоредактор в стиле CapCut (Electron + FFmpeg)'
arch=('any')
url='https://github.com/Flenstick/lincut'
license=('MIT')
# electron43, а не electron: LinCut собран и проверен на Electron 43, новая мажорная версия может что-то сломать
depends=('electron43' 'ffmpeg' 'hicolor-icon-theme')
optdepends=(
  'yt-dlp: импорт видео по ссылке'
  'uv: нейросети («Голос и фон», трекинг, «Вырезать объект»)'
  'wl-clipboard: вставка файлов из буфера под Wayland'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"
  local app="$pkgdir/usr/lib/$pkgname"
  install -d "$app/tools"
  cp -r main.js main-plugins.js main-shop.js preload.js package.json src assets examples "$app/"
  install -m644 tools/*.py "$app/tools/"

  # запуск: системный Electron 43 + папка программы
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/$pkgname" <<'SH'
#!/bin/sh
export CHROME_DESKTOP=lincut.desktop
exec electron43 /usr/lib/lincut --class=LinCut "$@"
SH

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$pkgname.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=LinCut
GenericName=Видеоредактор
Comment=Простой видеоредактор в стиле CapCut
Exec=lincut %F
Icon=lincut
Terminal=false
Categories=AudioVideo;Video;AudioVideoEditing;
StartupWMClass=LinCut
StartupNotify=true
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;
DESKTOP

  install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$pkgname.svg"
  install -Dm644 assets/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
